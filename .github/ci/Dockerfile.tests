FROM eclipse-temurin:25-jdk-noble

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        docker.io \
        git \
        imagemagick \
        libvips42t64 \
        libheif-plugin-libde265 \
        libimage-exiftool-perl \
        python3 \
    && rm -rf /var/lib/apt/lists/*

