{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql",
  "database.port": "3306",
  "database.user": "root",
  "database.password": "test",
  "database.server.id": "184054",
  "topic.prefix": "outbox-cdc",
  "database.include.list": "yeodam",
  "table.include.list": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:19092",
  "schema.history.internal.kafka.topic": "outbox-cdc-schema-history",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "skipped.operations": "u,d,t",
  "snapshot.mode": "initial",
  "snapshot.select.statement.overrides": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox",
  "transforms": "owned,outbox,key",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "outbox_id",
  "transforms.outbox.table.field.event.key": "trip_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "event_source:header:outbox-source,request_id:header:X-Request-ID",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.key.type": "org.apache.kafka.connect.transforms.Cast$Key",
  "transforms.key.spec": "string",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
  "producer.override.acks": "all",
  "producer.override.enable.idempotence": "true",
  "snapshot.select.statement.overrides.yeodam.trip_creation_outbox": "SELECT * FROM yeodam.trip_creation_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.additional_attachment_upload_outbox": "SELECT * FROM yeodam.additional_attachment_upload_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.story_generation_outbox": "SELECT * FROM yeodam.story_generation_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "transforms.owned.type": "io.debezium.transforms.Filter",
  "transforms.owned.language": "jsr223.groovy",
  "transforms.owned.condition": "value != null && (value.op == 'c' || value.op == 'r') && (value.after.cdc_managed == true || value.after.cdc_managed == 1)",
  "errors.tolerance": "none",
  "producer.override.delivery.timeout.ms": "10000",
  "producer.override.request.timeout.ms": "5000",
  "producer.override.max.block.ms": "10000"
}
